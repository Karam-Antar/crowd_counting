# Copy this file to .env and replace the placeholder values with your own configuration.
# This project reads configuration values from environment variables at startup.

# Core project paths
DATA_HOME=./datasets
TORCH_HOME=./.cache/torch

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_USERNAME=admin
MLFLOW_TRACKING_PASSWORD=change-me
MLFLOW_ADMIN_PASSWORD=change-me
MLFLOW_FLASK_SERVER_SECRET_KEY=change-me
MLFLOW_ENABLE_ASYNC_LOGGING=True
MLFLOW_DB_URL=sqlite:///mlflow.db

# Optuna
OPTUNA_DB_URL=sqlite:///optuna.db

# Storage / S3-compatible backend
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_ENDPOINT_URL=https://your-r2-or-s3-endpoint.example.com
MLFLOW_S3_ENDPOINT_URL=https://your-r2-or-s3-endpoint.example.com
ARTIFACT_ROOT=s3://mlflow/
